# Direct Google AI Studio key; never use the old proxy token here.
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite
GOOGLE_EMBED_MODEL=gemini-embedding-001
GOOGLE_INDEX_VERSION=v1
# Optional: leave blank to use the local Qdrant store.
QDRANT_URL=
QDRANT_API_KEY=

# auto uses QDRANT_URL if set; local retains cloud settings but uses disk.
QDRANT_STORAGE=auto
# Set 0.0.0.0 for container/public hosting.
GRADIO_SERVER_NAME=127.0.0.1
